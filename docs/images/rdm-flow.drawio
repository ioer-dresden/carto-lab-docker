        <mxCell id="366a2rFC2hLkZV0-yhS4-3" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;line-height: 90%; font-size: 10.5px;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Segoe UI Semibold&amp;quot;; font-weight: bold;&quot;&gt;Solving the &lt;br&gt;Environment&amp;nbsp;&lt;br&gt;Problem.&lt;/span&gt;&lt;font face=&quot;Segoe UI (Textkörper)&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 10.5px;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;Segoe UI (Textkörper)&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
