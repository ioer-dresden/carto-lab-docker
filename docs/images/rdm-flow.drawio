        </mxCell>
        <mxCell id="366a2rFC2hLkZV0-yhS4-14" value="TEXT" style="" parent="0" />
        <mxCell id="366a2rFC2hLkZV0-yhS4-8" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;div&gt;&lt;p style=&quot;margin-top: 0pt; margin-bottom: 0pt; margin-left: 0in; direction: ltr; unicode-bidi: embed; padding-right: 0px; padding-left: 0px;&quot;&gt;&lt;font style=&quot;line-height: 90%; font-size: 9.25px;&quot;&gt;&lt;font face=&quot;Segoe UI (Textkörper)&quot;&gt;CLD delivers a complete, versioned computational environment as a single Docker image.&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="366a2rFC2hLkZV0-yhS4-14" vertex="1">
          <mxGeometry x="130" y="370" width="110" height="70" as="geometry" />
        </mxCell>
        <mxCell id="366a2rFC2hLkZV0-yhS4-9" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;div style=&quot;padding-right: 5px; padding-left: 5px;&quot;&gt;&lt;font style=&quot;line-height: 90%; font-size: 9.25px;&quot;&gt;CLD is built for collaborative workflows, from onboarding new colleagues to co-authoring complex analyses.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="366a2rFC2hLkZV0-yhS4-14" vertex="1">
          <mxGeometry x="500" y="370" width="120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="366a2rFC2hLkZV0-yhS4-11" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 90%; font-size: 9.25px;&quot;&gt;&lt;font face=&quot;Segoe UI (Textkörper)&quot;&gt;CLD integrates CI/CD pipelines to automate the publication of research directly from Jupyter Notebooks.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="366a2rFC2hLkZV0-yhS4-14" vertex="1">
          <mxGeometry x="844" y="370" width="111" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eGoHJ3-BDez3vur0yncJ-16" value="&lt;ul style=&quot;padding-left: 15px; padding-right: 15px; padding-bottom: 5px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;strong style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;Versioned Images:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;&lt;br&gt;Pull specific CLD versions (e.g.,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; border: 0.727273px solid rgb(255, 255, 255); border-radius: 3px; padding: 0px 3px; display: inline-block; font-family: &amp;quot;DM Mono&amp;quot;, monospace;&quot; class=&quot;inline-code ng-star-inserted&quot;&gt;v0.15.7&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;) to perfectly replicate the exact environment a project was created in, years later.&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;strong style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;No More &quot;Dependency Hell&quot;:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;&lt;br&gt;All spatial packages (GDAL, QGIS, GRASS, Mapnik) and their complex C-dependencies are pre-compiled and compatibility-tested.&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;strong style=&quot;font-size: 10px; box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;Fast Environment Switching:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Two curated, pre-configured environments for Python and R, each packed with a compatible set of essential spatial libraries.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;" parent="366a2rFC2hLkZV0-yhS4-14" vertex="1">
          <mxGeometry x="256" y="250" width="194" height="270" as="geometry" />
        </mxCell>
        <mxCell id="366a2rFC2hLkZV0-yhS4-15" value="&lt;ul style=&quot;padding-left: 15px; padding-right: 10px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;strong style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;Live Collaboration:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;Share&lt;br&gt; interactive JupyterLab sessions via a secure link, allowing multiple &lt;br&gt;users to code and write in the same notebook simultaneously.&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;strong style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;Seamless Onboarding:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;&lt;br&gt;New team members can start instantly with a pre-configured environment, including Git access, without local setup.&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;/span&gt;&lt;strong style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;Isolated Team Instances:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, sans-serif;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;&lt;br&gt;At IOER, we provide dedicated, 24/7 instances for researchers, offering zero startup time and user-controlled versioning.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="366a2rFC2hLkZV0-yhS4-14" vertex="1">
