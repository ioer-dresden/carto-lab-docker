# Carto-Lab version tag to use (e.g., TAG=v1.1.0; defaults to latest)
# TAG=latest

# CONTAINER_NAME=lbsn-jupyterlab
# NETWORK_NAME=lbsn-network

# ------------------------------------------------------------------------------
# Authentication & Passwords
# ------------------------------------------------------------------------------
# Access password for JupyterLab web interface
# JUPYTER_PASSWORD=eX4mP13p455w0Rd

# PostgreSQL database passwords (available inside container environment)
# POSTGRES_PASSWORD=eX4mP13p455w0Rd
# READONLY_USER_PASSWORD=eX4mP13p455w0Rd

# Generate a random token on startup in addition to the password.
# The token is printed in logs and exported as $TOKEN inside the container.
# GENERATE_TOKEN=true

# ------------------------------------------------------------------------------
# Network & Server Settings
# ------------------------------------------------------------------------------
# Web port mapped on host (http://localhost:8888)
# JUPYTER_WEBPORT=8888

# Public web URL (e.g. https://jupyterlab.example.org)
# JUPYTER_WEBURL=http://localhost:8888

# Server auto-shutdown on inactivity in seconds (default: 1800; requires JUPYTER_WEBURL)
# JUPYTER_AUTOSHUTDOWN_TIMEOUT=1800

# ------------------------------------------------------------------------------
# Persistent Paths & Storage
# ------------------------------------------------------------------------------
# Host path for user notebooks/work directory (mounted to /home/jovyan/work)
# JUPYTER_NOTEBOOKS=${HOME}/notebooks

# Host path to persist custom conda environments (mounted to /envs)
# CONDA_ENVS=${HOME}/envs

# Host path to persist JupyterLab user settings, workspaces, and session cookies
# JUPYTER_STATE=${HOME}/.cartolab_state

# ------------------------------------------------------------------------------
# Git Configuration (inside container)
# ------------------------------------------------------------------------------
# Automatically configures global git user identity on container startup, e.g.
# GIT_USER_NAME="Alexander Dunkel"
# GIT_USER_EMAIL="a.dunkel@ioer.de"

# ------------------------------------------------------------------------------
# Extensions & Collaboration Features
# ------------------------------------------------------------------------------
# Enable Real-Time Collaboration (RTC) mode (default: false)
# COLLABORATIVE=true

# Disable Jupytext extension (default: false)
# DISABLE_JUPYTEXT=true

# Disable JupyterLab Git extension (default: false)
# DISABLE_JUPYTERLAB_GIT=true

# ------------------------------------------------------------------------------
# Build & Flavor Options
# ------------------------------------------------------------------------------
# Custom conda environment specifications for building custom worker_env
# ENVIRONMENT_FILE=environment_default.yml
# WORKER_ENV_NAME=worker_env

# Path to link external fonts when using the Mapnik flavor
# MAPNIK_FONTS=/usr/share/fonts

# Extra arguments passed directly to `jupyter lab` command on startup (e.g. --debug)
# JUPYTER_EXTRA_ARGS=

# ------------------------------------------------------------------------------
# Compose Layering / Flavors
# ------------------------------------------------------------------------------
# Define the compose file(s) to use.
# Base is docker-compose.yml. To enable a flavor, overlay it using a colon (:):
#
# QGIS flavor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.qgis.yml
#
# GRASS GIS flavor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.grass.yml
#
# Mapnik flavor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.mapnik.yml
#
# R flavor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.r.yml
#
COMPOSE_PATH_SEPARATOR=: